<?xml version="1.0" encoding="utf-8"?>
<!--
  Ficha técnica — sistema "Registro de laboratorio".

  Composición propia para esta pantalla: no es un dashboard de tarjetas, es un
  documento. El mismo patrón etiqueta-versalita + valor que usa el panel de
  lectura de la cámara se repite aquí como estructura de todo el contenido,
  separado por líneas de 1px en vez de contenedores redondeados — así una
  ficha con 3 líneas de EPP y otra con 8 se leen igual de bien, sin cajas de
  alto variable compitiendo entre sí.

  El color se reserva a lo que es realmente crítico: RIESGOS es la única
  etiqueta que usa @color/alert, porque es información de seguridad real, no
  una categoría más a la que darle su propio tono decorativo.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="@dimen/lab_space_3"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_6">

        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/lab_space_5"
            android:background="@drawable/drag_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_sheet"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Lab.Title"
            tools:text="Unidad de Destilación Kjeldahl" />

        <TextView
            android:id="@+id/tvEquipmentOfficial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_1"
            android:textAppearance="@style/TextAppearance.Lab.BodySoft"
            tools:text="J.P. SELECTA · Pro-Nitro A (Cat. 4002430)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lab_rule"
            android:layout_marginTop="@dimen/lab_space_5"
            android:background="@color/rule" />

        <!-- Función -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_5"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_function"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvFunction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="Destilación por arrastre de vapor para cuantificación de nitrógeno total y proteína cruda en alimentos." />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lab_rule"
            android:layout_marginTop="@dimen/lab_space_5"
            android:background="@color/rule" />

        <!-- EPP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_5"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_ppe"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvEPP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="• Mandil antifluidos blanco\n• Gafas de policarbonato con protección lateral\n• Guantes de nitrilo" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lab_rule"
            android:layout_marginTop="@dimen/lab_space_5"
            android:background="@color/rule" />

        <!-- Riesgos: única etiqueta con color — información de seguridad real -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_5"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_risks"
            android:textAppearance="@style/TextAppearance.Lab.Label"
            android:textColor="@color/alert" />

        <TextView
            android:id="@+id/tvRisks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="• Quemaduras térmicas por vapor caliente\n• Contacto accidental con reactivos corrosivos (NaOH 40%)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lab_rule"
            android:layout_marginTop="@dimen/lab_space_5"
            android:background="@color/rule" />

        <!-- Prácticas UTEQ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_5"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_practices"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvPractices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="• Práctica N° 03: Determinación de Proteína Cruda en Balanceados (AOAC 984.13)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultRAG"
            style="@style/Widget.Lab.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_6"
            android:text="@string/action_consult" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
