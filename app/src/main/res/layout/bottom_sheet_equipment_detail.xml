<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/obsidian_surface"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra de arrastre superior redondeada -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/drag_handle" />

        <!-- Badge de Categoría / Laboratorio -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_badge_muted"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FICHA TÉCNICA OFICIAL • BROMATOLOGÍA UTEQ"
                android:textAppearance="@style/TextAppearance.App.LabelSmall.Eyebrow" />
        </LinearLayout>

        <!-- Nombre Común del Equipo -->
        <TextView
            android:id="@+id/tvEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
            tools:text="Unidad de Destilación Kjeldahl" />

        <!-- Fabricante y Modelo Oficial -->
        <TextView
            android:id="@+id/tvEquipmentOfficial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary"
            tools:text="J.P. SELECTA • Pro-Nitro A (Cat. 4002430)" />

        <!-- TARJETA 1: Función y Principio Bromatológico -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_science"
                    app:tint="@color/neon_cyan" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Propósito y Función Analítica"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall"
                    android:textColor="@color/neon_cyan" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFunction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                tools:text="Destilación por arrastre de vapor para cuantificación de nitrógeno total y proteína cruda en alimentos." />
        </LinearLayout>

        <!-- TARJETA 2: EPP Obligatorio de Bioseguridad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/neon_rose" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Elementos de Protección Personal (EPP)"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall"
                    android:textColor="@color/neon_rose" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEPP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                tools:text="• Mandil antifluidos blanco\n• Gafas de policarbonato con protección lateral\n• Guantes de nitrilo" />
        </LinearLayout>

        <!-- TARJETA 3: Riesgos y Bioseguridad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/neon_amber" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Riesgos Operativos y Precauciones"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall"
                    android:textColor="@color/neon_amber" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRisks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                tools:text="• Quemaduras térmicas por vapor caliente\n• Contacto accidental con reactivos corrosivos (NaOH 40%)" />
        </LinearLayout>

        <!-- TARJETA 4: Prácticas UTEQ y Normativa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_flask"
                    app:tint="@color/neon_violet" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Guías de Práctica UTEQ y Normativas"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall"
                    android:textColor="@color/neon_violet" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPractices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                tools:text="• Práctica N° 03: Determinación de Proteína Cruda en Balanceados (AOAC 984.13)" />
        </LinearLayout>

        <!-- Botón de Consulta al Asistente RAG -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultRAG"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Consultar sobre este equipo (RAG)"
            app:icon="@drawable/ic_chat_bubble" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
