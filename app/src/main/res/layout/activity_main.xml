<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de cámara / detección — sistema "Registro de laboratorio".

  Composición: la cámara es el contenido, no un recuadro decorado flotando en
  una página. Debajo, la franja de equipos detectados (uno o varios) y el
  panel de lectura del equipo seleccionado. Sin HUD superpuesto, sin badges de
  estado, sin marcos de esquina, sin metadata del modelo: lo único que se
  afirma es qué equipos se ven, cuál está seleccionado, con cuánta confianza,
  y qué se puede hacer con él.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    tools:context=".MainActivity">

    <!-- Franja de identificación. Una sola línea, sin adornos. -->
    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="36dp"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_3"
        android:text="@string/brand_line"
        android:textAppearance="@style/TextAppearance.Lab.Label"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ruleTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_rule"
        android:background="@color/rule"
        app:layout_constraintTop_toBottomOf="@id/tvBrand" />

    <!-- Visor: a sangre, sin esquinas redondeadas ni borde. -->
    <FrameLayout
        android:id="@+id/cameraFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/ruleBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ruleTop">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <com.uteq.software.detector_de_materiales_laboratorio.ui.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <View
        android:id="@+id/ruleBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_rule"
        android:background="@color/rule"
        app:layout_constraintBottom_toTopOf="@id/stripEquipment" />

    <!--
      Franja de equipos detectados: uno o varios, cada uno una tarjeta de
      contorno (mismo lenguaje que las sugerencias del chat). Tocar una la
      selecciona (pasa a relleno de tinta) — igual que tocar su recuadro
      sobre la cámara. Altura fija con @dimen/lab_strip_height: reservada
      siempre, con o sin equipos, para no repetir el salto de altura.
    -->
    <HorizontalScrollView
        android:id="@+id/stripEquipment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_strip_height"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingEnd="@dimen/lab_gutter"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/ruleStrip">

        <LinearLayout
            android:id="@+id/stripEquipmentContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <View
        android:id="@+id/ruleStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_rule"
        android:background="@color/rule"
        app:layout_constraintBottom_toTopOf="@id/panelReading" />

    <!--
      Lectura: qué equipo, con cuánta confianza, y las dos acciones posibles.

      Altura estable por diseño, no por casualidad: ningún elemento cambia de
      visibilidad ni de tamaño de fuente entre el estado "sin detección" y
      "detectado" — solo cambia el texto y el color. tvEquipmentName fija
      minLines/maxLines=2 para que su caja mida siempre lo mismo sin importar
      si el contenido es una instrucción de una línea o un nombre de equipo.
    -->
    <LinearLayout
        android:id="@+id/panelReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="@dimen/lab_space_5"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_6"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/labelEquipment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lab_space_2"
            android:text="@string/field_status"
            android:textAppearance="@style/TextAppearance.Lab.Label"
            tools:text="@string/field_equipment" />

        <TextView
            android:id="@+id/tvEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="3sp"
            android:minLines="2"
            android:maxLines="2"
            android:text="@string/aim_at_equipment"
            android:textAppearance="@style/TextAppearance.Lab.Title"
            android:textColor="@color/ink_soft"
            tools:text="Destilador por Arrastre de Vapor tipo Kjeldahl" />

        <LinearLayout
            android:id="@+id/rowConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_4"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_confidence"
                android:textAppearance="@style/TextAppearance.Lab.Label" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lab_space_3"
                android:text="@string/confidence_placeholder"
                android:textAppearance="@style/TextAppearance.Lab.Readout"
                tools:text="87.1 %" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_5"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickDetails"
                style="@style/Widget.Lab.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/action_sheet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenChat"
                style="@style/Widget.Lab.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lab_space_3"
                android:layout_weight="1"
                android:text="@string/action_assistant" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
