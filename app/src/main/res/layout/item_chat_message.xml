<?xml version="1.0" encoding="utf-8"?>
<!--
  Turno de conversación — sistema "Registro de laboratorio".

  La respuesta del asistente es el contenido que el usuario vino a leer: fluye
  sin caja, como texto de la página, con una etiqueta "ASISTENTE" arriba en
  vez de un avatar o badge de modelo. La pregunta del usuario es la entrada,
  no el contenido — por eso es la única que lleva un bloque de fondo, alineado
  a la derecha, para poder escanear la conversación de un vistazo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/lab_space_3">

    <!-- Respuesta del asistente: sin caja -->
    <LinearLayout
        android:id="@+id/layoutBotMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBotHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lab_space_1"
            android:text="Asistente"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvBotMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="La unidad Kjeldahl se utiliza para destilación por arrastre de vapor en la determinación de nitrógeno total..." />

        <TextView
            android:id="@+id/tvBotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lab_space_1"
            android:textAppearance="@style/TextAppearance.Lab.Caption"
            tools:text="14:35" />

    </LinearLayout>

    <!-- Pregunta del usuario: única con bloque de fondo -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_user_message"
            android:lineSpacingExtra="4sp"
            android:paddingHorizontal="@dimen/lab_space_3"
            android:paddingVertical="@dimen/lab_space_2"
            android:textAppearance="@style/TextAppearance.Lab.Body"
            tools:text="¿Cuáles son los pasos para determinar proteína cruda?" />

        <TextView
            android:id="@+id/tvUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/lab_space_1"
            android:textAppearance="@style/TextAppearance.Lab.Caption"
            tools:text="14:36" />

    </LinearLayout>

</LinearLayout>
