<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="5dp">

    <!-- Burbuja del Asistente RAG (Bot) -->
    <LinearLayout
        android:id="@+id/layoutBotMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="42dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bot"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBotHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Asistente Bromatología"
                    android:textColor="@color/neon_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_live"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="GEMINI 2.5"
                    android:textColor="@color/neon_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBotMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3.5dp"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                tools:text="La unidad Kjeldahl se utiliza para destilación por arrastre de vapor en la determinación de nitrógeno total..." />

        </LinearLayout>

        <TextView
            android:id="@+id/tvBotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="14:35" />

    </LinearLayout>

    <!-- Burbuja del Usuario -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="42dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_user"
            android:elevation="2dp"
            android:lineSpacingExtra="2.5dp"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            tools:text="¿Cuáles son los pasos para determinar proteína cruda?" />

        <TextView
            android:id="@+id/tvUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="14:36" />

    </LinearLayout>

</LinearLayout>
