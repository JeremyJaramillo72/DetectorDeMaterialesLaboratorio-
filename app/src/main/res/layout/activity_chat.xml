<?xml version="1.0" encoding="utf-8"?>
<!--
  Asistente — sistema "Registro de laboratorio".

  Composición propia: un encabezado simple (volver + título), una línea de
  contexto real (qué equipo, o modo general — no un badge "IA ONLINE" que no
  refleja ningún estado verificado), sugerencias como contorno compacto, y una
  conversación donde solo la pregunta del usuario lleva un bloque de fondo;
  la respuesta del asistente es el contenido principal y se lee como texto de
  la página, sin burbuja. Sin "GEMINI 2.5", sin FAB circular.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/lab_space_2"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_3"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lab_space_1"
            android:text="@string/chat_title"
            android:textAppearance="@style/TextAppearance.Lab.Subtitle" />

    </LinearLayout>

    <View
        android:id="@+id/ruleHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_rule"
        android:background="@color/rule"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader" />

    <!-- Contexto real: qué equipo limita la conversación, o modo general.
         Mismo patrón etiqueta + valor que el resto del sistema. -->
    <LinearLayout
        android:id="@+id/layoutSelectedChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="@dimen/lab_space_3"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_3"
        app:layout_constraintTop_toBottomOf="@id/ruleHeader">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/lab_space_1"
            android:text="@string/field_context"
            android:textAppearance="@style/TextAppearance.Lab.Label" />

        <TextView
            android:id="@+id/tvActiveEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Lab.BodySoft"
            tools:text="Unidad de Destilación Kjeldahl" />

    </LinearLayout>

    <View
        android:id="@+id/ruleContext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lab_rule"
        android:background="@color/rule"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectedChip" />

    <!-- Sugerencias rápidas: contorno compacto, sin ícono, sin relleno de color. -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="24dp"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="@dimen/lab_space_3"
        android:paddingEnd="28dp"
        android:paddingBottom="@dimen/lab_space_3"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/ruleContext">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPPE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lab_space_2"
                android:background="@drawable/bg_chip_outline"
                android:paddingStart="@dimen/lab_space_3"
                android:paddingTop="@dimen/lab_space_2"
                android:paddingEnd="@dimen/lab_space_3"
                android:paddingBottom="@dimen/lab_space_2"
                android:text="¿Qué EPP necesito?"
                android:textAppearance="@style/TextAppearance.Lab.Chip" />

            <TextView
                android:id="@+id/chipProcedure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lab_space_2"
                android:background="@drawable/bg_chip_outline"
                android:paddingStart="@dimen/lab_space_3"
                android:paddingTop="@dimen/lab_space_2"
                android:paddingEnd="@dimen/lab_space_3"
                android:paddingBottom="@dimen/lab_space_2"
                android:text="¿Procedimiento paso a paso?"
                android:textAppearance="@style/TextAppearance.Lab.Chip" />

            <TextView
                android:id="@+id/chipPractices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lab_space_2"
                android:background="@drawable/bg_chip_outline"
                android:paddingStart="@dimen/lab_space_3"
                android:paddingTop="@dimen/lab_space_2"
                android:paddingEnd="@dimen/lab_space_3"
                android:paddingBottom="@dimen/lab_space_2"
                android:text="¿Qué prácticas UTEQ aplica?"
                android:textAppearance="@style/TextAppearance.Lab.Chip" />

            <TextView
                android:id="@+id/chipRisks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_outline"
                android:paddingStart="@dimen/lab_space_3"
                android:paddingTop="@dimen/lab_space_2"
                android:paddingEnd="@dimen/lab_space_3"
                android:paddingBottom="@dimen/lab_space_2"
                android:text="¿Cuáles son los riesgos?"
                android:textAppearance="@style/TextAppearance.Lab.Chip" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/lab_gutter"
        android:paddingTop="@dimen/lab_space_2"
        android:paddingEnd="@dimen/lab_gutter"
        android:paddingBottom="@dimen/lab_space_3"
        app:layout_constraintBottom_toTopOf="@id/layoutInputDock"
        app:layout_constraintTop_toBottomOf="@id/scrollChips"
        tools:listitem="@layout/item_chat_message" />

    <!-- Entrada: barra plana con regla superior, sin cápsula flotante ni FAB. -->
    <LinearLayout
        android:id="@+id/layoutInputDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/lab_rule"
            android:background="@color/rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/lab_gutter"
            android:paddingTop="@dimen/lab_space_2"
            android:paddingEnd="@dimen/lab_space_2"
            android:paddingBottom="@dimen/lab_space_2">

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chat_hint_general"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingVertical="10dp"
                android:paddingEnd="@dimen/lab_space_2"
                android:textAppearance="@style/TextAppearance.Lab.Body"
                android:textColorHint="@color/ink_faint" />

            <ImageButton
                android:id="@+id/btnVoiceInput"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dictar mensaje"
                android:padding="12dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/ink_soft" />

            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/lab_space_1"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Enviar mensaje"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
