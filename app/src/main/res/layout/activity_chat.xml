<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_base">

    <!-- Header Toolbar Glassmorphic -->
    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asistente RAG Bromatología"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini 2.5 Flash • UTEQ"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall.Muted"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_secondary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="IA ONLINE"
                android:textAppearance="@style/TextAppearance.App.LabelSmall.Muted"
                android:textColor="@color/neon_cyan" />

        </LinearLayout>

    </LinearLayout>

    <!-- Banner de contexto: equipo activo / modo general -->
    <LinearLayout
        android:id="@+id/layoutSelectedChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader">

        <ImageView
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_science"
            app:tint="@color/neon_cyan" />

        <TextView
            android:id="@+id/tvActiveEquipment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.LabelLarge"
            android:textColor="@color/neon_cyan"
            tools:text="Equipo Activo: Unidad de Destilación Kjeldahl" />

    </LinearLayout>

    <!-- Chips de Preguntas Rápidas -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="24dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="28dp"
        android:paddingBottom="8dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectedChip">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPPE"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="¿Qué EPP necesito?"
                app:chipIcon="@drawable/ic_shield" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcedure"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="¿Procedimiento paso a paso?"
                app:chipIcon="@drawable/ic_assignment" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPractices"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="¿Qué prácticas UTEQ aplica?"
                app:chipIcon="@drawable/ic_flask" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRisks"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Cuáles son los riesgos?"
                app:chipIcon="@drawable/ic_warning"
                app:chipIconTint="@color/neon_amber" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista de Mensajes del Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layoutInputDock"
        app:layout_constraintTop_toBottomOf="@id/scrollChips"
        tools:listitem="@layout/item_chat_message" />

    <!-- Barra Inferior de Entrada Flotante (Glass Capsule) -->
    <LinearLayout
        android:id="@+id/layoutInputDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_base"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Escribe o dicta tu consulta..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingVertical="10dp"
                android:paddingHorizontal="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnVoiceInput"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dictar mensaje"
                android:padding="8dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/neon_cyan" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSendMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/neon_emerald"
                android:contentDescription="Enviar mensaje"
                app:elevation="4dp"
                app:fabCustomSize="42dp"
                app:srcCompat="@drawable/ic_send"
                app:tint="@color/obsidian_base" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
