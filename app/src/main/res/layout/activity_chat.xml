<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uteq_surface">

    <!-- Barra de Herramientas / Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/uteq_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Asistente RAG Bromatología"
        app:titleTextColor="@color/white" />

    <!-- Chip del Equipo Seleccionado -->
    <LinearLayout
        android:id="@+id/layoutSelectedChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarChat">

        <TextView
            android:id="@+id/tvActiveEquipment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/uteq_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="🔬 Equipo Activo: Unidad de Destilación Kjeldahl" />

    </LinearLayout>

    <!-- Chips de Preguntas Rápidas -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectedChip">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupQuickQuestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPPE"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦺 ¿Qué EPP necesito?"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_border" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProcedure"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 ¿Procedimiento paso a paso?"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_border" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPractices"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 ¿Qué prácticas UTEQ aplica?"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_border" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRisks"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ ¿Cuáles son los riesgos?"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_border" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Lista de Mensajes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/layoutInputBar"
        app:layout_constraintTop_toBottomOf="@id/scrollChips"
        tools:listitem="@layout/item_chat_message" />

    <!-- Barra Inferior de Entrada de Texto -->
    <LinearLayout
        android:id="@+id/layoutInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/chat_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/uteq_accent"
            android:contentDescription="Enviar"
            app:fabCustomSize="46dp"
            app:srcCompat="@android:drawable/ic_menu_send"
            app:tint="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
