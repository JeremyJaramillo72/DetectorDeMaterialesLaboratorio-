<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>

    <!-- ============================================================
         IDENTIDAD "REGISTRO DE LABORATORIO"
         Papel cálido + tinta grafito. La estructura la dan la
         tipografía, la alineación y las líneas de 1px; NO tarjetas.
         Un solo acento, reservado al estado real de detección.
         Contraste medido (WCAG 2.1, luminancia relativa):
           ink        / paper = 16.19:1
           ink_soft   / paper =  6.12:1
           ink_faint  / paper =  4.81:1   (etiquetas versalitas 10.5sp)
           accent     / paper =  8.03:1
           alert      / paper =  6.53:1
           white      / ink   = 18.11:1   (botón primario)
         ============================================================ -->
    <color name="paper">#F4F2ED</color>
    <color name="paper_sunken">#EAE7E0</color>
    <color name="ink">#14161A</color>
    <color name="ink_soft">#565B62</color>
    <color name="ink_faint">#656B72</color>
    <color name="rule">#DDD9D0</color>
    <color name="rule_strong">#C3BFB5</color>
    <color name="accent">#14524B</color>
    <color name="alert">#9A3412</color>

    <!-- Capa de cámara: se dibuja sobre imagen real impredecible, por eso NO usa
         los colores del sistema claro sino su propio tratamiento de contraste
         (línea de tinta sobre halo blanco). Ver OverlayView.kt. -->
    <color name="overlay_line">#FF14161A</color>
    <color name="overlay_halo">#E6FFFFFF</color>
    <color name="overlay_label_bg">#F214161A</color>
    <color name="overlay_readout">#CCFFFFFF</color>
</resources>
