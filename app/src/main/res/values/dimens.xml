<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sistema "Registro de laboratorio" -->
    <!-- Margen de página: todo el contenido se alinea a esta columna -->
    <dimen name="lab_gutter">20dp</dimen>
    <!-- Ritmo vertical -->
    <dimen name="lab_space_1">4dp</dimen>
    <dimen name="lab_space_2">8dp</dimen>
    <dimen name="lab_space_3">12dp</dimen>
    <dimen name="lab_space_4">16dp</dimen>
    <dimen name="lab_space_5">20dp</dimen>
    <dimen name="lab_space_6">28dp</dimen>
    <!-- Radio único del sistema: casi recto, deliberadamente no-cápsula -->
    <dimen name="lab_radius">3dp</dimen>
    <!-- Grosor de las líneas que estructuran la página -->
    <dimen name="lab_rule">1dp</dimen>
    <dimen name="lab_action_height">52dp</dimen>

    <!-- Accesibilidad: objetivo táctil mínimo -->
    <dimen name="touch_target_min">48dp</dimen>
</resources>
