<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
         Tema base — sistema claro "Registro de laboratorio".
         Material Components se usa como capa de COMPORTAMIENTO
         (ripple, estados, accesibilidad, insets). Las formas, radios,
         sombras y tipografía NO se heredan del catálogo M3: se fijan
         explícitamente abajo como decisiones del sistema propio.
         ============================================================ -->
    <style name="Base.Theme.DetectorDeMaterialesLaboratorio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/alert</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper_sunken</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/rule_strong</item>
        <item name="colorOutlineVariant">@color/rule</item>

        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.DetectorDeMaterialesLaboratorio" parent="Base.Theme.DetectorDeMaterialesLaboratorio" />

    <!-- ==================== Componentes del sistema ==================== -->

    <!-- Acción principal: rectángulo de tinta, esquina de 3dp (no cápsula),
         sin elevación ni sombra. El estado deshabilitado es información real:
         significa que todavía no hay un equipo detectado que consultar. -->
    <style name="Widget.Lab.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/lab_radius</item>
        <item name="backgroundTint">@color/btn_ink_bg</item>
        <item name="android:textColor">@color/btn_ink_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Lab.Action</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">@dimen/lab_action_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Acción secundaria: solo contorno de 1px, sin relleno. -->
    <style name="Widget.Lab.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/lab_radius</item>
        <item name="strokeColor">@color/btn_outline_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/btn_outline_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Lab.Action</item>
        <item name="rippleColor">#1A14161A</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">@dimen/lab_action_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

</resources>
