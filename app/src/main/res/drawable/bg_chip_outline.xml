<?xml version="1.0" encoding="utf-8"?>
<!-- Sugerencia rápida: contorno de 1px, radio del sistema (3dp), sin relleno.
     No es un Chip de Material — es un rectángulo con ripple propio. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A14161A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke
                android:width="1dp"
                android:color="@color/rule_strong" />
            <corners android:radius="@dimen/lab_radius" />
        </shape>
    </item>
</ripple>
